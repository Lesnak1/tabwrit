# ---------------------------------------------------------------------------
# TabWrit — environment template. Copy to .env, never commit .env.
# Secrets are generated by the setup scripts and written only to .env.
#
# IMPORTANT: The TESTNET_*_ACCOUNT_ID values below are the author's live demo
# accounts. For a fresh deployment, choose unique names you control before
# running `pnpm testnet:setup`; otherwise the helper skips the existing
# accounts and you will not have their keys. See REPRODUCE.md.
# ---------------------------------------------------------------------------

# NEAR network
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com

# MCP / agent account and its scoped Function-Call key
NEAR_ACCOUNT_ID=tab-agent.testnet
NEAR_PRIVATE_KEY=ed25519:...

# Current testnet deployment
TAB_VAULT_CONTRACT_ID=tab-vault.testnet
TAB_TOKEN_ID=tab-usdc.testnet
MERCHANT_ACCOUNT_ID=tab-merchant.testnet
AGENT_ACCOUNT_ID=tab-agent.testnet

# Merchant backend key. Must be a Function-Call key on tab-merchant.testnet
# scoped to tab-vault.testnet::charge. Never commit the real value.
MERCHANT_CHARGE_PRIVATE_KEY=ed25519:...

# Optional storage registrar for mainnet 1Click deposit addresses.
# A Function-Call key cannot attach the NEP-145 storage deposit, so this is
# a separate low-balance account with a full-access key.
STORAGE_ACCOUNT_ID=
STORAGE_PRIVATE_KEY=

# Optional merchant keeper
KEEPER_API_KEY=
TAB_WEBHOOK_SECRET=
KEEPER_CORS_ORIGIN=http://localhost:3005

# NEAR Intents / 1Click
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
# A real mainnet NEAR account used as the quote preview refund target.
ONECLICK_REFUND_ACCOUNT=near.near

# Browser-visible configuration (safe to expose)
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_TAB_VAULT_CONTRACT_ID=tab-vault.testnet
NEXT_PUBLIC_TAB_TOKEN_ID=tab-usdc.testnet
NEXT_PUBLIC_TAB_TOKEN_SYMBOL=tUSDC
NEXT_PUBLIC_TAB_TOKEN_DECIMALS=6
NEXT_PUBLIC_MERCHANT_ACCOUNT_ID=tab-merchant.testnet
NEXT_PUBLIC_AGENT_ACCOUNT_ID=tab-agent.testnet
NEXT_PUBLIC_MERCHANT_INVOICE_AMOUNT=10000000
NEXT_PUBLIC_DEMO_ACCOUNT_ID=tab-demo.testnet

# ---------------------------------------------------------------------------
# Testnet setup credentials. The names below are the author's live demo
# accounts. For a fresh deployment, choose your own names (for example
# myteam-vault.testnet) before running `pnpm testnet:setup`; the testnet
# helper will create them. Placeholders only in the template.
# ---------------------------------------------------------------------------
TESTNET_VAULT_ACCOUNT_ID=tab-vault.testnet
TESTNET_VAULT_PRIVATE_KEY=ed25519:...
TESTNET_TOKEN_ACCOUNT_ID=tab-usdc.testnet
TESTNET_TOKEN_PRIVATE_KEY=ed25519:...
TESTNET_MERCHANT_ACCOUNT_ID=tab-merchant.testnet
TESTNET_MERCHANT_PRIVATE_KEY=ed25519:...
TESTNET_MERCHANT_CHARGE_PRIVATE_KEY=ed25519:...
TESTNET_DEMO_ACCOUNT_ID=tab-demo.testnet
TESTNET_DEMO_PRIVATE_KEY=ed25519:...
TESTNET_AGENT_ACCOUNT_ID=tab-agent.testnet
TESTNET_AGENT_PRIVATE_KEY=ed25519:...
TESTNET_AGENT_CHARGE_PRIVATE_KEY=ed25519:...

# Optional fresh test wallet used by `pnpm test:tester` (testnet only).
TESTER_ACCOUNT_ID=tab-tester.testnet
TESTER_PRIVATE_KEY=ed25519:...

# NEP-366 gasless charge relayer (testnet). The relayer only pays gas; it never
# holds an owner or merchant key. RELAYER_API_KEY authenticates /relay/delegate.
RELAYER_ACCOUNT_ID=tab-relayer.testnet
RELAYER_PRIVATE_KEY=ed25519:...
RELAYER_API_KEY=
RELAYER_URL=http://localhost:4000
