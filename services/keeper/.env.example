# Optional merchant keeper. Copy to services/keeper/.env. Gitignored.
# These defaults point at the testnet demo. For mainnet, change the network,
# RPC, vault, token and merchant values together; see docs/DEPLOYMENT.md.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
TAB_VAULT_CONTRACT_ID=tab-vault.testnet
TAB_TOKEN_ID=tab-usdc.testnet
MERCHANT_ACCOUNT_ID=tab-merchant.testnet
MERCHANT_CHARGE_PRIVATE_KEY=
STORAGE_ACCOUNT_ID=
STORAGE_PRIVATE_KEY=
KEEPER_API_KEY=
TAB_WEBHOOK_SECRET=

# NEP-366 gasless charge relayer. The relayer account only pays gas and never
# holds an owner or merchant key. It only relays delegates signed by a
# Function-Call key scoped to <TAB_VAULT_CONTRACT_ID>::charge.
RELAYER_ACCOUNT_ID=tab-relayer.testnet
RELAYER_PRIVATE_KEY=
RELAYER_API_KEY=
RELAYER_MAX_GAS=100000000000000
RELAYER_MAX_BLOCK_WINDOW=200
RELAYER_RATE_LIMIT=10
# Optional path for the per-sender gas meter. Gitignored.
RELAYER_USAGE_FILE=./relay-usage.json

# Local development; set this to the Vercel URL in a hosted deployment.
KEEPER_CORS_ORIGIN=http://localhost:3005
# Most hosts set PORT themselves. Local default:
PORT=4000

ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
ONECLICK_REFUND_ACCOUNT=near.near
